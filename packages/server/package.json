{
  "name": "@artifacts/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "spec:fetch": "node scripts/fetch-spec.mjs",
    "spec:generate": "tsx scripts/generate-openapi.ts",
    "generate": "openapi-ts && node scripts/annotate-sdk.mjs && node scripts/nocheck-runtime.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@artifacts/shared": "*",
    "@fastify/type-provider-typebox": "^6.1.0",
    "fastify": "^5.2.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "typebox": "^1"
  },
  "devDependencies": {
    "@fastify/swagger": "^9.5.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
